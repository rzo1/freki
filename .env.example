# Copy to .env and fill in. CLI flags override these values.
GITLAB_URL=https://gitlab.example.com
# scopes: read_api (+ read_repository if GITLAB_GIT_PROTOCOL=https)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_OUTPUT_DIR=./gitlab-export
GITLAB_INCLUDE_ARCHIVED=false
GITLAB_CLONE_WIKI=true
GITLAB_CLONE_LFS=true
# also keep a working-tree checkout of the default branch next to each mirror
GITLAB_CHECKOUT=true
# export issues / merge requests (comments + attachments) next to each mirror
GITLAB_EXPORT_ISSUES=true
GITLAB_EXPORT_MRS=true
GITLAB_CONCURRENCY=4
# ssh (default, uses your ssh agent/keys) or https (uses the token)
GITLAB_GIT_PROTOCOL=ssh
